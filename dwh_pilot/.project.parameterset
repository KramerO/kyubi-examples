apiVersion: kyubi/v1
kind: Project
metadata:
  name: dwh_pilot
  description: Pilot – synthetisches DWH (Staging → SCD2-Dimension → Fakten → Mart) als Jobnetz
include: [../shared]   # Kalender, db_config und Datasets aus der Sandbox shared (D-124)
scheduler:
  resources: {db_slots: 2}
  max_parallel_jobs: 3
  timezone: Europe/Berlin
  new_day: "00:05"
  # Benachrichtigungen: lokal aus, weil jede Zustellung an einen nicht erreichbaren
  # Webhook als Fehler im Control Center steht. Zum Einschalten KYUBI_PILOT_HOOK auf einen
  # echten Teams-/Slack-/Mattermost-Webhook setzen und die vier Zeilen einkommentieren.
  # notifications:
  #   channels:
  #     ops: {type: webhook, url: "${env.KYUBI_PILOT_HOOK}"}
  #   rules:
  #     - {events: [failed, instance_failed, sla_missed], channels: [ops]}
